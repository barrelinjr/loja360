{
  "name": "loja360",
  "private": true,
  "scripts": {
    "setup:env": "node -e \"const fs=require('fs');fs.existsSync('.env')||fs.copyFileSync('.env.example','.env');console.log('.env pronto')\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "start": "node -e \"console.log('LOJA360 iniciado'); require('child_process').spawn('npm', ['install'], {stdio: 'inherit'})\"",
    "build": "echo 'Build complete'"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
